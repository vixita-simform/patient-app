{
  "name": "patient-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@patient-app/mobile",
    "ios": "npm run ios --workspace=@patient-app/mobile",
    "android": "npm run android --workspace=@patient-app/mobile",
    "backend": "npm run dev --workspace=@patient-app/backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
