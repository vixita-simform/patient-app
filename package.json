{
  "name": "patient-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@patient-app/mobile",
    "ios": "npm run ios --workspace=@patient-app/mobile",
    "android": "npm run android --workspace=@patient-app/mobile",
    "backend": "npm run dev --workspace=@patient-app/backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint",
    "eslint-fix": "npm run lint --workspaces --if-present -- --fix",
    "pretty": "npm run pretty --workspaces --if-present",
    "spelling": "npm run spelling --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "cspell": "^8.17.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
